{
  "name": "@mapuc/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:all",
    "build:all": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"{apps,libs,test,scripts}/**/*.ts\"",
    "format:check": "prettier --check \"{apps,libs,test,scripts}/**/*.ts\"",
    "start": "npm run start:api:dev",
    "dev": "npm run start:api:dev",
    "start:api": "node dist/apps/api/src/main.js",
    "start:api:dev": "nest start api --watch",
    "start:realtime": "node dist/apps/realtime/src/main.js",
    "start:realtime:dev": "nest start realtime --watch",
    "start:workers": "node dist/apps/workers/src/main.js",
    "start:workers:dev": "nest start workers --watch",
    "lint": "eslint \"{apps,libs,test,scripts}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node -r ts-node/register -r tsconfig-paths/register scripts/ejecutar-migraciones.ts",
    "db:revert": "node -r ts-node/register -r tsconfig-paths/register scripts/revertir-ultima-migracion.ts",
    "test": "jest --config jest.config.js --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:performance": "k6 run ../tests/performance/backend-550k.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^12.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/platform-ws": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.28",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "ioredis": "^5.11.1",
    "nats": "^2.29.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {}
}
